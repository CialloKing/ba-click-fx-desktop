#include <winver.h>

1 VERSIONINFO
 FILEVERSION @BAFX_VERSION_MAJOR@,@BAFX_VERSION_MINOR@,@BAFX_VERSION_PATCH@,@BAFX_VERSION_REVISION@
 PRODUCTVERSION @BAFX_VERSION_MAJOR@,@BAFX_VERSION_MINOR@,@BAFX_VERSION_PATCH@,@BAFX_VERSION_REVISION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "BAFX native control center\0"
            VALUE "FileVersion", "@BAFX_VERSION@\0"
            VALUE "InternalName", "BAFX.ControlCenter\0"
            VALUE "OriginalFilename", "BAFX.ControlCenter.exe\0"
            VALUE "ProductName", "ba-click-fx-desktop\0"
            VALUE "ProductVersion", "@BAFX_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
