{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "x64 (Spout2 enabled)",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BAFX_ENABLE_DESKTOP_SMOKE_TESTS": "ON",
        "BAFX_ENABLE_SPOUT2": "ON",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "x64-slim",
      "displayName": "x64 Slim (Spout2 disabled)",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BAFX_ENABLE_DESKTOP_SMOKE_TESTS": "ON",
        "BAFX_ENABLE_SPOUT2": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "x64",
      "configuration": "Release",
      "jobs": 2,
      "nativeToolOptions": [
        "/nodeReuse:false"
      ]
    },
    {
      "name": "host-release",
      "displayName": "Build Desktop Host Release",
      "configurePreset": "x64",
      "configuration": "Release",
      "targets": [
        "ba_click_fx_desktop"
      ],
      "nativeToolOptions": [
        "/nodeReuse:false"
      ]
    },
    {
      "name": "release-package-verify",
      "displayName": "Verify packaged Release",
      "configurePreset": "x64",
      "configuration": "Release",
      "targets": [
        "verify_release_package"
      ]
    },
    {
      "name": "slim-release",
      "displayName": "Build Slim Release",
      "configurePreset": "x64-slim",
      "configuration": "Release",
      "jobs": 2,
      "nativeToolOptions": [
        "/nodeReuse:false"
      ]
    },
    {
      "name": "slim-release-package-verify",
      "displayName": "Verify packaged Slim Release",
      "configurePreset": "x64-slim",
      "configuration": "Release",
      "targets": [
        "verify_release_package"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Test Debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "displayName": "Test Release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "slim-release",
      "displayName": "Test Slim Release",
      "configurePreset": "x64-slim",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "release",
      "displayName": "Package Release ZIP",
      "configurePreset": "x64",
      "generators": [
        "ZIP"
      ],
      "configurations": [
        "Release"
      ]
    },
    {
      "name": "slim-release",
      "displayName": "Package Slim Release ZIP",
      "configurePreset": "x64-slim",
      "generators": [
        "ZIP"
      ],
      "configurations": [
        "Release"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "release-verify",
      "displayName": "Configure, build, and test Release",
      "steps": [
        {
          "type": "configure",
          "name": "x64"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "release-package",
      "displayName": "Configure, build, test, and package Release",
      "steps": [
        {
          "type": "configure",
          "name": "x64"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        },
        {
          "type": "package",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release-package-verify"
        }
      ]
    },
    {
      "name": "slim-release-verify",
      "displayName": "Configure, build, and test Slim Release",
      "steps": [
        {
          "type": "configure",
          "name": "x64-slim"
        },
        {
          "type": "build",
          "name": "slim-release"
        },
        {
          "type": "test",
          "name": "slim-release"
        }
      ]
    },
    {
      "name": "slim-release-package",
      "displayName": "Configure, build, test, and package Slim Release",
      "steps": [
        {
          "type": "configure",
          "name": "x64-slim"
        },
        {
          "type": "build",
          "name": "slim-release"
        },
        {
          "type": "test",
          "name": "slim-release"
        },
        {
          "type": "package",
          "name": "slim-release"
        },
        {
          "type": "build",
          "name": "slim-release-package-verify"
        }
      ]
    }
  ]
}
